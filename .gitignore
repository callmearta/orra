# --- secrets -------------------------------------------------------------
# API keys for Deepgram, AssemblyAI and Gemini. Never commit these.
.env
.env.*
!.env.example
*orra.bak

# --- Rust ----------------------------------------------------------------
/src-tauri/target/
# Regenerated by tauri-build on every compile.
/src-tauri/gen/schemas/

# --- frontend ------------------------------------------------------------
/flow-insights-dashboard/node_modules/
/flow-insights-dashboard/dist/

# --- packaging -----------------------------------------------------------
# What `makepkg` leaves behind: the source tarball it downloaded, the tree it
# unpacked it into, and the package it built. Only the four files the AUR wants
# belong in the repository.
/packaging/aur/src/
/packaging/aur/pkg/
/packaging/aur/*.tar.gz
/packaging/aur/*.pkg.tar.*

# --- editors and OS ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
