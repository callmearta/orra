# Maintainer: Arta <arta@orra.ai>
#
# This directory is what the AUR repository holds, flat: PKGBUILD, .SRCINFO,
# orra.desktop, LICENSE. The AUR rejects a push whose .SRCINFO is out of step
# with the PKGBUILD, so regenerate it after any edit here:
#
#     makepkg --printsrcinfo > .SRCINFO
#
# For a new release, `./bump.sh 0.1.4` does that and the version and hash with
# it. Then copy all four files into a clone of ssh://aur@aur.archlinux.org/orra.git
# and push.

pkgname=orra
pkgver=0.1.4
pkgrel=1
pkgdesc="Hold a key, speak, and the words are typed into whatever window has focus"
arch=('x86_64')
# LTO off, and this is not a preference. Distributions that enable it by default
# in makepkg.conf — CachyOS ships it on — build `ring` (the TLS crate in the
# websocket stack) into LTO bitcode, and the symbols its hand-written assembly
# exports do not survive to the link:
#
#     rust-lld: error: undefined symbol: ring_core_0_17_14__p384_elem_mul_mont
#
# Without this, the package fails to build for exactly the people this package
# manager targets. Nothing here is measurably slower for it.
options=('!lto')
url="https://github.com/callmearta/orra"
# No license is granted yet — see LICENSE, which is the README's own statement.
# Worth replacing with a real one: helpers warn on `custom`, and people read it
# as "do not use this".
license=('custom')
# The same set the .deb declares: the two tools the app shells out to for
# typing, and the three libraries the webview and tray are built against.
depends=('wtype' 'wl-clipboard' 'libayatana-appindicator' 'webkit2gtk-4.1' 'gtk3')
makedepends=('cargo' 'npm' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "orra.desktop"
        "LICENSE")
sha256sums=('e57a2a18153a14782d0d1f1a82dbab1484bf4ab3ee11e0bc2528a8a7a0eb6fc5' 'SKIP' 'SKIP')

build() {
  cd "$pkgname-$pkgver"

  # The settings UI is compiled *into* the binary — cargo embeds it, because the
  # `custom-protocol` feature is on by default — so it has to be built first.
  # That is also why the tauri CLI is not needed here, and why a plain cargo
  # build produces the same binary the releases ship.
  (
    cd flow-insights-dashboard
    npm ci
    npm run build
  )

  (
    cd src-tauri
    cargo build --release --locked
  )
}

check() {
  cd "$pkgname-$pkgver"

  (
    cd flow-insights-dashboard
    npm test
  )

  # The offline half of the Rust suite. What needs an API key or a live service
  # is marked `#[ignore]` and is deliberately not run here — a package build
  # has no network to give it.
  (
    cd src-tauri
    cargo test --release --locked
  )
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 src-tauri/target/release/orra "$pkgdir/usr/bin/orra"
  # The compositor binds call this one by absolute path, so it has to sit
  # beside the app rather than anywhere else on PATH.
  install -Dm755 src-tauri/target/release/orra-ctl "$pkgdir/usr/bin/orra-ctl"

  install -Dm644 "$srcdir/orra.desktop" "$pkgdir/usr/share/applications/Orra.desktop"

  # Exactly the sizes the repository carries; the larger ones in the .deb are
  # scaled by tauri's bundler from icon.png.
  for size in 32x32 64x64 128x128 256x256; do
    install -Dm644 "src-tauri/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/orra.png"
  done

  # Required of any package that is not under a recognised license.
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
